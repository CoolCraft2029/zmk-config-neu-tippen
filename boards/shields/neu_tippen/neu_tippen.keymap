// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // Position order = row-major, left half first (0-27) then
    // right half (28-55), matching the matrix transform in
    // neu_tippen.dtsi.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ---- Left half ----
&kp ESC   &kp TAB   &kp Q &kp W &kp E &kp R &kp T
&kp DEL   &kp CAPS  &kp A &kp S &kp D &kp F &kp G
&kp GRAVE &kp LSHFT &kp Z &kp X &kp C &kp V &kp B
&mo 1     &kp LCTRL &none &kp BACKSLASH &kp LGUI &kp LALT &kp SPACE

// ---- Right half ----
&kp Y     &kp U &kp I     &kp O    &kp P    &kp MINUS    &kp BSPC
&kp H     &kp J &kp K     &kp L    &kp SEMI &kp SQT  &kp RET
&kp N     &kp M &kp COMMA &kp DOT  &kp FSLH &kp UP   &kp RSHFT
&kp SPACE &kp EQUAL &kp LBKT &kp RBKT  &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        fn_layer {
            bindings = <
// ---- Left half: F-keys, media keys on the spare column ----
&kp ESC &kp EXCLAMATION &kp AT_SIGN &kp HASH  &kp DOLLAR &kp PERCENT  &kp CARET
&kp C_BRI_UP  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
&kp C_BRI_DN &kp LSHFT  &to 0  &to 2  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
&trans  &kp C_VOL_DN     &kp C_MUTE     &kp C_VOL_UP    &kp C_PREVIOUS    &kp C_PLAY_PAUSE       &kp C_NEXT 

// ---- Right half: numpad row / F-keys / brightness+screenshot ----
&kp AMPERSAND &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N7 &kp N8 &kp N9
&kp F7 &kp F8 &kp F9  &kp KP_PLUS &kp N4 &kp N5 &kp N6
&kp F10  &kp F11   &kp F12  &kp KP_MINUS &kp N1 &kp N2 &kp N3
&none &bt BT_CLR  &none  &none KP_DIVIDE &kp N0 &kp KP_DOT &kp KP_ENTER
            >;
        };

        mac_layer {
            bindings = <
// ---- Left half ----
&kp ESC   &kp TAB   &kp Q &kp W &kp E &kp R &kp T
&kp DEL   &kp CAPS  &kp A &kp S &kp D &kp F &kp G
&kp GRAVE &kp LSHFT &kp Z &kp X &kp C &kp V &kp B
&mo 1 &kp LCTRL &none &kp BACKSLASH &kp LALT &kp LGUI &kp SPACE

// ---- Right half ----
&kp Y     &kp U &kp I     &kp O    &kp P    &kp MINUS    &kp BSPC
&kp H     &kp J &kp K     &kp L    &kp SEMI &kp SQT  &kp RET
&kp N     &kp M &kp COMMA &kp DOT  &kp FSLH &kp UP   &kp RSHFT
&kp SPACE &kp EQUAL &kp LBKT &kp RBKT  &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
    };
};
